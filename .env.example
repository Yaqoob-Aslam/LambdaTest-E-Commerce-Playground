# ---------------------------------------------------------------------------
# Environment configuration (copy to `.env` and fill in).
#    cp .env.example .env
# `.env` is git-ignored and must never contain committed secrets.
# ---------------------------------------------------------------------------

# Which named environment to run against: local | dev | staging | prod
TEST_ENV=local

# Base URL of the application under test (overrides the environment default).
BASE_URL=https://ecommerce-playground.lambdatest.io

# Registered account used by authenticated specs. Leave blank to auto-skip.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Opt-in guards for destructive scenarios on the shared public demo store.
# Set to 1 only when you intend to create real accounts / place real orders.
ALLOW_REGISTRATION=
ALLOW_ORDER_PLACEMENT=

# Execution tuning (optional — safe defaults are applied when unset).
# RETRIES=2
# WORKERS=4
# TIMEOUT=30000
# EXPECT_TIMEOUT=10000
# NAVIGATION_TIMEOUT=30000

# Comma-separated project filter, e.g. chromium,firefox,api
# PROJECTS=chromium
